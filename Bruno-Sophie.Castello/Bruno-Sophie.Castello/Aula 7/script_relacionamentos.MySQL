CREAT DATABASE CASTELLO_RELACIONAMENTOS;

USE CASTELLO_RELACIONAMENTOS;

CREAT TABE PRODUTO(
    ID_PRODUTO INT AUTO_INCREMENT PRIMARY KEY,
    NOME_PRODUTO VARCHAR(100) NOT NUL
);

CREAT TABE ESTOQUE(
    ID_ESTOQUE INT AUTO_INCREMENT PRIMARY KEY,
    ID_PRODUTO INT NOT NULL UNIQUE,
    QUANTIDADE INT NOT NUL,
    FOREGN (ID_PRODUTO) REFERENCES PRODUTO(ID_PRODUTO)
);